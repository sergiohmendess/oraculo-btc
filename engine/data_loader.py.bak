import pandas as pd
import os

def load_raw_data():
    base_path = os.path.join(os.path.dirname(__file__), 'data', 'btc_base.csv')
    print(f"[data_loader] Carregando: {base_path}")

    if not os.path.exists(base_path):
        raise FileNotFoundError(f"Arquivo não encontrado: {base_path}")

    df = pd.read_csv(base_path)

    print(f"[data_loader] Linhas carregadas: {len(df)}")
    return df
