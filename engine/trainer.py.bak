from sklearn.ensemble import RandomForestClassifier

FEATURES = ['rsi14', 'sma20', 'ema20', 'ret']

def train_model(df):
    df = df.dropna(subset=FEATURES + ['ret'])

    X = df[FEATURES]
    y = (df['ret'] > 0).astype(int)

    model = RandomForestClassifier(n_estimators=200, random_state=42)
    model.fit(X, y)
    print('[trainer] Modelo treinado com sucesso!')

    return model
